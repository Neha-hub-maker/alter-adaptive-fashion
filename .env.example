# Optional canonical/share URL: set to the real deployed origin, without a trailing path.
# If omitted, VERCEL_PROJECT_PRODUCTION_URL is used on Vercel; otherwise alter.example.
NEXT_PUBLIC_SITE_URL=https://your-alter-site.example

# Fictional portfolio brand: default false (noindex, nofollow and blocked crawling).
# Set exactly true and rebuild to permit indexing of / and /credits.
# /style-guide remains noindex, nofollow and excluded from the sitemap in either mode.
NEXT_PUBLIC_ALLOW_INDEXING=false
